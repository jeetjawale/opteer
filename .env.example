# ================================================
# JobPilot — Environment Configuration
# ================================================

# Active AI Provider (gemini | anthropic | openai | xai | local | mock)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# Per-task model overrides (optional, falls back to AI_MODEL)
AI_MODEL_FIT=
AI_MODEL_LETTER=
AI_MODEL_PREP=

# LLM Provider API Keys (only fill the one you use)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Web Scraping & Research
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Next.js Frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8085

# Local LLM (optional — Ollama or vLLM)
# AI_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2