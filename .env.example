# ================================================
# JobPilot — Environment Configuration
# ================================================

# Environment
ENVIRONMENT=development # set to 'production' for prod deploys

# Active AI Provider (gemini | anthropic | openai | xai | local | mock)
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite

# Per-task model overrides (optional, falls back to AI_MODEL)
AI_MODEL_FIT=
AI_MODEL_LETTER=
AI_MODEL_PREP=
AI_MODEL_TAILOR=

# LLM Provider API Keys (only fill the one you use)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
MINIMAX_API_KEY=
MOONSHOT_API_KEY=

# Web Scraping & Research
FIRECRAWL_API_KEY=
TAVILY_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Next.js Frontend
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080

# Local LLM (optional — Ollama or vLLM)
# AI_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.2

# Security (32 url-safe base64-encoded bytes)
# Note: You MUST generate your own key for production
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

# Network
# JSON array of allowed origins for CORS.
# REQUIRED for production (cannot be just localhost:3000).
CORS_ORIGINS='["https://yourdomain.com"]'

# Comma-separated list of trusted proxies, or "*" for any proxy.
# Required if backend is behind nginx, AWS ALB, etc., to accurately rate limit by IP.
# TRUSTED_PROXIES="127.0.0.1"