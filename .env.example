# LLM Provider API Keys (Bring Your Own Keys)
# Provide at least one of the following to use the AI features:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Search / Research API Keys
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Security (Required)
# Generate a 32 url-safe base64-encoded string for API key encryption
# e.g., using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=your-32-byte-base64-encoded-secret-key-here

# Note: Infrastructure variables like DATABASE_URL are automatically managed by docker-compose.yml.
