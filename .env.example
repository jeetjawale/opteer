# ==========================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# ==========================================
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/opteer
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=DEBUG
SENTRY_DSN=your_sentry_dsn_here

# 32-byte url-safe base64 string for encrypting user API keys
API_KEY_ENCRYPTION_KEY=your_32_byte_base64_encryption_key_here

CORS_ORIGINS='[
  "http://localhost:3000"
]'



# Telemetry
ENABLE_TIMING_LOGS=true

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (frontend/.env.local)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_LOGO_DEV_TOKEN=your_logo_dev_token_here